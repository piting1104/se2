        <mxCell id="jq9TzH2uNkwYObjfaG3h-4" value="&lt;div&gt;CALL KEYSCAN_NONBLOCK&amp;nbsp; （玩家按鍵掃描控制）&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;非阻塞式按鍵處理 (左移、右移、重置)&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
