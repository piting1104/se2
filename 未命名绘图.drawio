        <mxCell id="jq9TzH2uNkwYObjfaG3h-6" value="&lt;div&gt;CALL CHECK_COLLISION&amp;nbsp; （檢查是否有碰撞）&lt;/div&gt;&lt;div&gt;檢查 X軸、Y軸是否重疊&lt;/div&gt;&lt;div&gt;碰撞時啟動閃爍、計數器、或重置遊戲&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
